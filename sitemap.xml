<?xml version="1.0" encoding="UTF-8"?>
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
  xmlns:image="http://www.google.com/schemas/sitemap-image/1.1"
>

  <!-- ═══════════════════════════════════════════
       PRIMARY URL — single-page portfolio.

       NOTE ON SCOPE: this is a client-side single-page app, so there
       is exactly one crawlable document. Earlier versions of this
       sitemap listed each in-page section as its own <url> entry
       (…/#s1, …/#s2, etc.) — URL fragments are never sent to the
       server and Google explicitly does not treat them as distinct
       pages for indexing, so those entries did nothing useful and
       risked reading as low-value/duplicate URLs. Removed.
  ═══════════════════════════════════════════ -->
  <url>
    <loc>https://eladdaudet.dev/</loc>
    <lastmod>2026-08-31</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>

    <!-- Multilingual alternates. These now resolve to real localized
         content — ?lang= is read on load (see core.js initLangFromURL)
         and switching language updates the URL, so a crawler visiting
         any of these actually receives that language's content. -->
    <xhtml:link rel="alternate" hreflang="en"        href="https://eladdaudet.dev/"/>
    <xhtml:link rel="alternate" hreflang="fr"        href="https://eladdaudet.dev/?lang=fr"/>
    <xhtml:link rel="alternate" hreflang="es"        href="https://eladdaudet.dev/?lang=es"/>
    <xhtml:link rel="alternate" hreflang="ja"        href="https://eladdaudet.dev/?lang=ja"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://eladdaudet.dev/"/>

    <!-- Hero / OG preview image — helps this page surface in Google
         Image Search for name and headshot-adjacent queries too. -->
    <image:image>
      <image:loc>https://eladdaudet.dev/og-preview.png</image:loc>
      <image:title>Elad Anedo Daudet Ikeorah — DevSecOps &amp; Agentic AI Automation Engineer</image:title>
      <image:caption>Interactive 3D portfolio of Elad Anedo Daudet Ikeorah — DevSecOps Engineer and Agentic AI Automation Specialist. Founder of MisterComp Cameroon.</image:caption>
    </image:image>

    <!-- Professional headshot -->
    <image:image>
      <image:loc>https://eladdaudet.dev/img/elad-headshot.jpg</image:loc>
      <image:title>Elad Anedo Daudet Ikeorah</image:title>
      <image:caption>Elad Anedo Daudet Ikeorah, DevSecOps Engineer and Agentic AI Automation Specialist.</image:caption>
    </image:image>
  </url>

  <!-- ═══════════════════════════════════════════
       DOWNLOADABLE ASSET
       Lets Google index the résumé document directly, so it can
       surface in results for name + "resume"/"CV" searches.
  ═══════════════════════════════════════════ -->
  <url>
    <loc>https://eladdaudet.dev/ELAD_DAUDET_RESUME_en.pdf</loc>
    <lastmod>2026-08-31</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.6</priority>
  </url>

</urlset>
